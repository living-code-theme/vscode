    "panelTitle.activeForeground": "#12171a",
    "panelTitle.inactiveForeground": "#92999f",
    "statusBar.background": "#e0e5e9",
    "statusBar.foreground": "#50565a",
    "statusBar.border": "#d2d8dd",
