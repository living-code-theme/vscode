  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6b7378",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.logical.lua",
        "keyword.operator.wordlike",
        "keyword.operator.word",
        "keyword.other",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.keyword",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#0f695e"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#6b7378"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#92999f"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#3b7a35"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.character.format",
        "constant.character.entity"
      ],
      "settings": {
        "foreground": "#a04f27"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#81558e"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#a04f27"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "support.constant",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#a04f27"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#1f7074"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.numeric.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.byte.go",
        "storage.type.rune.go",
        "storage.type.error.go",
        "storage.type.uintptr.go",
        "support.class.component",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union",
        "entity.name.trait",
        "entity.name.interface",
        "entity.name.impl"
      ],
      "settings": {
        "foreground": "#2b6991"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module",
        "entity.name.scope-resolution",
        "support.module"
      ],
      "settings": {
        "foreground": "#2b6991"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "punctuation.definition.decorator",
        "meta.decorator variable",
        "meta.decorator variable.other",
        "meta.decorator variable.other.readwrite",
        "meta.decorator entity.name.function",
        "storage.type.annotation",
        "meta.attribute.rust",
        "entity.name.function.macro",
        "entity.name.function.preprocessor",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.type.lifetime",
        "punctuation.definition.lifetime",
        "meta.annotation",
        "variable.annotation",
        "punctuation.definition.annotation",
        "entity.name.label",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#81558e"
      }
    },
    {
      "scope": [
        "keyword.control.directive.include",
        "keyword.control.directive.import",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#0f695e"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#81558e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#2e3437"
      }
    },
    {
      "scope": [
        "variable.other.enummember",
        "variable.other.constant.property",
        "variable.other.property",
        "variable.other.object.property",
        "variable.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "punctuation.support.type.property-name",
        "entity.name.tag.yaml",
        "entity.name.tag.toml",
        "variable.other.key.toml",
        "support.type.property-name.json",
        "meta.attribute.python"
      ],
      "settings": {
        "foreground": "#2e3437"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter variable"
      ],
      "settings": {
        "foreground": "#2e3437",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.variable",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#0f695e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other.readwrite",
        "variable.other.constant",
        "constant.other.caps",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#12171a"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#187d6e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#1f7074",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#8f6213"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6b7378",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation.definition.list",
        "markup.list punctuation.definition"
      ],
      "settings": {
        "foreground": "#187d6e"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#3b7a35"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#a74541"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#8f6213"
      }
    },
    {
      "scope": [
        "meta.diff.range",
        "meta.diff.index",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#6b7378"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#a74541"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8f6213"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": {
      "foreground": "#2e3437",
      "italic": true
    },
    "property": "#2e3437",
    "function": "#1f7074",
    "method": "#1f7074",
    "type": "#2b6991",
    "class": "#2b6991",
    "interface": "#2b6991",
    "enum": "#2b6991",
    "typeParameter": "#2b6991",
    "enumMember": "#2e3437",
    "namespace": "#2b6991",
    "decorator": "#81558e",
    "macro": "#81558e",
    "variable.defaultLibrary": "#0f695e",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
