  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#747c80",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.logical.lua",
        "keyword.operator.wordlike",
        "keyword.operator.word",
        "keyword.other",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.keyword",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#52d7c1"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#747c80"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#50565b"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#8acb83"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.character.format",
        "constant.character.entity"
      ],
      "settings": {
        "foreground": "#e18c5f"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#bf91cd"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#e18c5f"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "support.constant",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#e18c5f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#9ae0dd"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.numeric.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.byte.go",
        "storage.type.rune.go",
        "storage.type.error.go",
        "storage.type.uintptr.go",
        "support.class.component",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union",
        "entity.name.trait",
        "entity.name.interface",
        "entity.name.impl"
      ],
      "settings": {
        "foreground": "#80b6d3"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module",
        "entity.name.scope-resolution",
        "support.module"
      ],
      "settings": {
        "foreground": "#80b6d3"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "punctuation.definition.decorator",
        "meta.decorator variable",
        "meta.decorator variable.other",
        "meta.decorator variable.other.readwrite",
        "meta.decorator entity.name.function",
        "storage.type.annotation",
        "meta.attribute.rust",
        "entity.name.function.macro",
        "entity.name.function.preprocessor",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.type.lifetime",
        "punctuation.definition.lifetime",
        "meta.annotation",
        "variable.annotation",
        "punctuation.definition.annotation",
        "entity.name.label",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#bf91cd"
      }
    },
    {
      "scope": [
        "keyword.control.directive.include",
        "keyword.control.directive.import",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#52d7c1"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#bf91cd"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c8cfd4"
      }
    },
    {
      "scope": [
        "variable.other.enummember",
        "variable.other.constant.property",
        "variable.other.property",
        "variable.other.object.property",
        "variable.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "punctuation.support.type.property-name",
        "entity.name.tag.yaml",
        "entity.name.tag.toml",
        "variable.other.key.toml",
        "support.type.property-name.json",
        "meta.attribute.python"
      ],
      "settings": {
        "foreground": "#c8cfd4"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter variable"
      ],
      "settings": {
        "foreground": "#c8cfd4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.variable",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#52d7c1",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other.readwrite",
        "variable.other.constant",
        "constant.other.caps",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#e2e9ee"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#00a692",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#9ae0dd",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#f0be6d"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#747c80",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation.definition.list",
        "markup.list punctuation.definition"
      ],
      "settings": {
        "foreground": "#00a692"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#8acb83"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#e96560"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#f0be6d"
      }
    },
    {
      "scope": [
        "meta.diff.range",
        "meta.diff.index",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#747c80"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e96560"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f0be6d"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": {
      "foreground": "#c8cfd4",
      "italic": true
    },
    "property": "#c8cfd4",
    "function": "#9ae0dd",
    "method": "#9ae0dd",
    "type": "#80b6d3",
    "class": "#80b6d3",
    "interface": "#80b6d3",
    "enum": "#80b6d3",
    "typeParameter": "#80b6d3",
    "enumMember": "#c8cfd4",
    "namespace": "#80b6d3",
    "decorator": "#bf91cd",
    "macro": "#bf91cd",
    "variable.defaultLibrary": "#52d7c1",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
